# ==============================================================================
# Industrial Evidence Chain — Environment Configuration Template (.env.example)
# Copy this file to .env or set these environment variables in your shell / IDE.
# ==============================================================================

# ── Database Secrets (PostgreSQL) ──────────────────────────────────────────────
# PostgreSQL database credentials for the ASP.NET Core backend.
# NEVER commit your actual password to version control!
DB_HOST=localhost
DB_PORT=5432
DB_NAME=industrial_evidence_chain
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Alternatively, set the full standard ASP.NET Core connection string:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=industrial_evidence_chain;Username=postgres;Password=your_password

# ── JWT Authentication Secrets ────────────────────────────────────────────────
# Minimum 32 characters secret key for signing HMAC-SHA256 JWT tokens
JwtSettings__Secret=REPLACE_WITH_SECURE_RANDOM_SECRET_MINIMUM_32_CHARACTERS
JwtSettings__Issuer=IndustrialEvidenceChain
JwtSettings__Audience=IndustrialEvidenceChainClients
JwtSettings__ExpiryMinutes=60

# ── Admin User Initial Bootstrap (Seed Utility Only) ──────────────────────────
ADMIN_BOOTSTRAP_PASSWORD=your_initial_admin_password_here

# ── Blockchain / Fabric Network Configuration ─────────────────────────────────
BLOCKCHAIN_ADAPTER_MODE=mock-in-memory
FABRIC_MSP_ID=Org1MSP
BLOCKCHAIN_GATEWAY_URL=http://localhost:4000

# ── Frontend Configuration (Vite React) ───────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5212/api
VITE_USE_MOCK_API=false
VITE_APP_NAME=Industrial Evidence Chain
VITE_APP_VERSION=1.0.0
VITE_ENABLE_QR_SCANNER=true
VITE_ENABLE_CAMERA_CAPTURE=true
VITE_ENABLE_GEOLOCATION=true
