rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{evidenceId}/{fileName} {
      // Evidence media is publicly readable for verification and proof display
      allow read: if true;
      // Uploading media requires an authenticated technician or manager
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

